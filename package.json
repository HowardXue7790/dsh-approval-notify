{
  "name": "dsh-approval-notify",
  "version": "1.0.0",
  "description": "Windows toast notifications for DSH approval requests, with the reason rewritten by a model into plain language and Allow/Deny buttons on the toast.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "show.ps1",
    "shortcut.ps1",
    "watch.ps1",
    "focus.ps1",
    "answer.vbs",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "docs"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "approval",
    "notification",
    "toast",
    "windows"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HowardXue7790/dsh-approval-notify.git"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-settings"]
    }
  }
}
